{
  "name": "trades-app",
  "private": true,
  "version": "1.0.0",
  "description": "Two-sided on-demand services marketplace (customers + tradespeople) — monorepo",
  "workspaces": [
    "packages/*",
    "backend",
    "apps/*"
  ],
  "scripts": {
    "build:domain": "npm run build -w @trades/domain",
    "test:domain": "npm test -w @trades/domain",
    "test:sql": "bash backend/test/sql/run.sh",
    "dev:api": "npm run start:dev -w @trades/backend",
    "dev:admin": "npm run dev -w @trades/admin",
    "dev:web": "npm run dev -w @trades/web",
    "dev:customer": "npm run start -w @trades/customer-app",
    "dev:provider": "npm run start -w @trades/provider-app",
    "db:migrate": "npm run migrate -w @trades/backend",
    "db:seed": "npm run seed -w @trades/backend",
    "test": "npm run test:domain && npm test -w @trades/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "expo": "52.0.49",
    "expo-constants": "17.0.8",
    "expo-device": "7.0.3",
    "expo-font": "13.0.4",
    "expo-notifications": "0.29.14",
    "expo-router": "4.0.22",
    "expo-secure-store": "14.0.1",
    "metro": "0.81.5",
    "metro-babel-transformer": "0.81.5",
    "metro-cache": "0.81.5",
    "metro-cache-key": "0.81.5",
    "metro-config": "0.81.5",
    "metro-file-map": "0.81.5",
    "metro-minify-terser": "0.81.5",
    "metro-resolver": "0.81.5",
    "metro-symbolicate": "0.81.5",
    "metro-transform-plugins": "0.81.5",
    "metro-transform-worker": "0.81.5",
    "query-string": "7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.3"
  },
  "dependencies": {
    "@expo/vector-icons": "14.0.4",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0"
  }
}

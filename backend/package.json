{
  "name": "@trades/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Trades marketplace API \u2014 NestJS modular monolith (modules map 1:1 to spec \u00a7B services)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:worker": "node dist/src/worker.js",
    "migrate": "node dist/src/scripts/migrate.js",
    "seed": "node dist/src/scripts/seed-demo.js",
    "test": "npm run test:sql && npm run test:e2e",
    "test:sql": "bash test/sql/run.sh",
    "lint": "eslint 'src/**/*.ts'",
    "test:e2e": "npm run build && bash test/e2e/db.sh start && node test/e2e/run-e2e.js; status=$?; bash test/e2e/db.sh stop; exit $status",
    "create-staff": "node dist/src/scripts/create-staff.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/websockets": "^10.3.0",
    "@trades/domain": "*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "otplib": "^12.0.1",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}